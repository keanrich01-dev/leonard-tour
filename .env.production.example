# Configure these values in Render's Environment settings, never commit a populated .env file.
# DATABASE_URL: Neon pooled endpoint, converted by the app to psycopg v3.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DB?sslmode=require
# DIRECT_DATABASE_URL: Neon direct (non-pooler) endpoint used only by Alembic migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DB?sslmode=require
REDIS_URL=rediss://default:UPSTASH_PASSWORD@YOUR-UPSTASH-HOST:6379
SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
TRUST_PROXY=false
CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN

PAYMENT_PROVIDER=pesapal
PESAPAL_CONSUMER_KEY=YOUR_LIVE_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=YOUR_LIVE_CONSUMER_SECRET
PESAPAL_BASE_URL=https://pay.pesapal.com/pesapalv3
PUBLIC_API_URL=https://YOUR_API_DOMAIN
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
DEPOSIT_PERCENT=30
CHILD_PRICE_FACTOR=1.0

EMAIL_BACKEND=smtp
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=no-reply@YOUR_DOMAIN
EMAIL_FROM_NAME=Leonard Tour
EMAIL_REPLY_TO=info@YOUR_DOMAIN
ADMIN_NOTIFY_EMAILS=info@YOUR_DOMAIN
COMPANY_NAME=Leonard Tour
COMPANY_CONTACT=info@YOUR_DOMAIN
CELERY_EAGER=false
BALANCE_REMINDER_DAYS=14

MEDIA_STORAGE_BACKEND=r2
MEDIA_PUBLIC_URL=https://media.YOUR_DOMAIN
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_BUCKET_SCOPED_SECRET_ACCESS_KEY
R2_BUCKET=leonard-tour-media
