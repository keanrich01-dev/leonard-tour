# Local Docker Compose only. Copy to .env and replace all sample values.
POSTGRES_USER=leonard_tour
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=leonard_tour
DATABASE_URL=postgresql+psycopg://leonard_tour:replace-with-a-long-random-local-password@localhost:5432/leonard_tour
DIRECT_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173

# Local payment sandbox. Live credentials must be configured in the hosting dashboard.
PAYMENT_PROVIDER=pesapal
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
DEPOSIT_PERCENT=30
CHILD_PRICE_FACTOR=1.0

# Mailpit receives all local development mail (http://localhost:8025).
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@localhost
EMAIL_FROM_NAME=Leonard Tour
EMAIL_REPLY_TO=info@localhost
ADMIN_NOTIFY_EMAILS=info@localhost
COMPANY_NAME=Leonard Tour
COMPANY_CONTACT=info@localhost
CELERY_EAGER=false
BALANCE_REMINDER_DAYS=14

# Local media by default. For production, select r2 and complete all R2 settings.
MEDIA_STORAGE_BACKEND=local
MEDIA_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
